# ==============================================================================
# EasierJulesBot Environment Configuration Template
# Copy this file to .env and configure the values:
#   cp .env.example .env
# ==============================================================================

# [Required] Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# [Optional / Recommended] Telegram User ID of the bot administrator.
# Required for executing admin commands: /restart, /update, /stop.
# You can obtain your Telegram user ID from bots like @userinfobot.
ADMIN_ID=123456789

# [Optional] Proxy server URL for Telegram Bot and Jules API requests.
# Supports HTTP/HTTPS/SOCKS5 proxies. Node.js natively supports standard proxy env variables.
# Examples:
#   http_proxy=http://127.0.0.1:8080
#   https_proxy=http://127.0.0.1:8080
http_proxy=
https_proxy=

# [Optional] Custom GitHub repository URL for the /update command.
# If omitted, /update will automatically run `git pull` on the current upstream repository.
# Example:
#   GITHUB_REPO=https://github.com/h434ni/EasierJulesBot
GITHUB_REPO=

# ------------------------------------------------------------------------------
# NOTE:
# - Jules API Key and Group settings are managed interactively through the bot:
#   send /start to the bot in a private chat to connect your account and group.
# ------------------------------------------------------------------------------
