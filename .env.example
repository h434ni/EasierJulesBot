# ==============================================================================
# EasierJulesBot Environment Configuration Template (Rust Edition)
# Copy this file to .env and configure the values:
#   cp .env.example .env
# ==============================================================================

# [Required] Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# [Optional] Proxy server URL for Telegram Bot and Jules API requests.
# Supports HTTP/HTTPS/SOCKS5 proxies.
# PROXY=socks5://127.0.0.1:9050
# PROXY=http://127.0.0.1:8080

# [Optional] SQLite Database Path (Defaults to "bot.db")
DB_PATH=bot.db
